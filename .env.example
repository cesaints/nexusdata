# =============================================================================
# NexusData — Exemplo de variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o `.env` real.
# =============================================================================

# ---- App ----
NEXUS_ENVIRONMENT=local                # local | staging | production
NEXUS_DEBUG=false
NEXUS_LOG_LEVEL=INFO
NEXUS_API_HOST=0.0.0.0
NEXUS_API_PORT=8000
NEXUS_API_PREFIX=/api/v1
NEXUS_CORS_ORIGINS=["http://localhost:5173"]

# ---- Segurança (JWT) ----
# GERE UMA CHAVE FORTE: `openssl rand -hex 32`  (>= 32 bytes). Obrigatório em prod.
NEXUS_JWT_SECRET_KEY=CHANGE_ME_dev_only_secret_do_not_use_in_production_00000000
NEXUS_JWT_ALGORITHM=HS256
NEXUS_ACCESS_TOKEN_EXPIRE_MINUTES=15
NEXUS_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Banco relacional (PostgreSQL) ----
NEXUS_POSTGRES_HOST=localhost
NEXUS_POSTGRES_PORT=5432
NEXUS_POSTGRES_USER=nexus
NEXUS_POSTGRES_PASSWORD=nexus_dev_password
NEXUS_POSTGRES_DB=nexusdata
NEXUS_DB_POOL_SIZE=10
NEXUS_DB_MAX_OVERFLOW=20

# ---- Redis (cache / rate limit / idempotência) ----
NEXUS_REDIS_HOST=localhost
NEXUS_REDIS_PORT=6379
NEXUS_REDIS_DB=0
NEXUS_REDIS_PASSWORD=

# ---- RabbitMQ (broker Celery) ----
NEXUS_RABBITMQ_HOST=localhost
NEXUS_RABBITMQ_PORT=5672
NEXUS_RABBITMQ_USER=nexus
NEXUS_RABBITMQ_PASSWORD=nexus_dev_password
NEXUS_RABBITMQ_VHOST=/

# ---- Rate limiting ----
NEXUS_RATE_LIMIT_REQUESTS=100
NEXUS_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Idempotência ----
NEXUS_IDEMPOTENCY_TTL_SECONDS=86400

# ---- Webhooks ----
NEXUS_WEBHOOK_TIMEOUT_SECONDS=10
NEXUS_WEBHOOK_MAX_RETRIES=5

# ---- Processamento / IA (plugável) ----
# provider: mock | claude | openai
NEXUS_AI_PROVIDER=mock
NEXUS_AI_API_KEY=
NEXUS_AI_MAX_RETRIES=3
NEXUS_CIRCUIT_BREAKER_FAIL_THRESHOLD=5
NEXUS_CIRCUIT_BREAKER_RESET_SECONDS=30

# ---- Qdrant (opcional / busca semântica) ----
NEXUS_QDRANT_ENABLED=false
NEXUS_QDRANT_HOST=localhost
NEXUS_QDRANT_PORT=6333

# ---- Observabilidade ----
NEXUS_OTEL_ENABLED=false
NEXUS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXUS_METRICS_ENABLED=true
